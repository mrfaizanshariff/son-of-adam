{% comment %}
  SON OF ADAM - Scent Grid Section
  Grid of fragrance product cards from a collection. Renders nothing when the collection is empty.
  Products follow the collection's own sort order (manual order is respected); no sort is applied here.
  Badges only appear for the product tags "badge:new" and "badge:limited".
{% endcomment %}

{%- liquid
  assign grid_collection = section.settings.collection
  assign has_products = false
  if grid_collection != blank and grid_collection.products_count > 0
    assign has_products = true
  endif
-%}

{%- if has_products -%}
  <section
    class="scent-grid full-width section-spacing bg-{{ section.settings.background_color }} scent-grid--{{ section.settings.background_color }}"
    style="--scent-grid-columns: {{ section.settings.columns_desktop }}"
    {% if section.settings.heading != blank %}aria-labelledby="scent-grid-heading-{{ section.id }}"{% endif %}
  >
    <div class="scent-grid__container">
      <div class="scent-grid__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title scent-grid__heading" id="scent-grid-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <a href="{{ grid_collection.url }}" class="scent-grid__view-all">
          {{- 'products.view_all' | t -}}
          <span class="visually-hidden"> {{ grid_collection.title | escape }}</span>
        </a>
      </div>

      <ul class="scent-grid__list" role="list">
        {%- for product in grid_collection.products limit: section.settings.limit -%}
          <li class="scent-grid__item">
            {%- render 'product-card',
              product: product,
              show_family: section.settings.show_family,
              show_notes: section.settings.show_notes,
              tag_badges_only: true
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .scent-grid {
    inline-size: 100%;
  }

  .scent-grid__container {
    max-inline-size: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .scent-grid__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm, 16px);
    margin-block-end: var(--spacing-xl, 48px);
  }

  .scent-grid__heading {
    margin: 0;
  }

  .scent-grid__view-all {
    margin-inline-start: auto;
    font-family: var(--font-header);
    font-size: var(--font-size-small, 14px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .scent-grid__view-all:focus-visible {
    outline: 2px solid var(--color-harvest-gold);
    outline-offset: 4px;
  }

  /* Mobile: auto-fit with a minimum wider than half the mobile viewport, so cards stack */
  .scent-grid__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--spacing-lg, 32px) var(--spacing-md, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .scent-grid__item {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
  }

  .scent-grid--oxford-blue {
    color: var(--color-white);
  }

  .scent-grid--oxford-blue .product-card__title-link {
    color: inherit;
  }

  .scent-grid--oxford-blue .product-card__notes {
    color: var(--color-silver);
  }

  @media (min-width: 768px) {
    .scent-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .scent-grid__list {
      grid-template-columns: repeat(var(--scent-grid-columns, 3), minmax(0, 1fr));
      column-gap: var(--spacing-lg, 32px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scent grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The six"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products follow the collection's sort order."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_family",
      "label": "Show scent family",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Show top notes",
      "default": true
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Background Color",
      "options": [
        { "value": "sea-salt", "label": "Sea Salt" },
        { "value": "white", "label": "White" },
        { "value": "oxford-blue", "label": "Oxford Blue" }
      ],
      "default": "white"
    }
  ],
  "presets": [
    {
      "name": "Scent grid",
      "category": "Collection",
      "settings": {
        "collection": "perfumes"
      }
    }
  ]
}
{% endschema %}
