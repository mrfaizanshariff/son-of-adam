{% comment %}
  SON OF ADAM - Proof Strip Section
  Row of short trust claims with icons. Disabled blocks and blocks without a heading are skipped.
  Renders nothing when no claim qualifies.
{% endcomment %}

{%- liquid
  assign claim_count = 0
  capture claims_html
    for block in section.blocks
      if block.type == 'claim' and block.settings.enabled and block.settings.heading != blank
        assign claim_count = claim_count | plus: 1
        render 'proof-strip-item', block: block
      endif
    endfor
  endcapture
-%}

{%- if claim_count > 0 -%}
  <section class="proof-strip full-width bg-oxford-blue" style="--proof-strip-columns: {{ claim_count | at_most: 4 }}">
    <div class="proof-strip__container">
      <ul class="proof-strip__list" role="list">
        {{ claims_html }}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .proof-strip {
    width: 100%;
    padding-block: var(--spacing-xl, 48px);
    color: var(--color-sea-salt);
  }

  .proof-strip__container {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .proof-strip__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .proof-strip__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs, 8px);
    margin: 0;
    padding: 0;
  }

  .proof-strip__icon {
    display: inline-flex;
    color: var(--color-harvest-gold);
    margin-bottom: var(--spacing-xs, 8px);
  }

  .proof-strip__heading {
    margin: 0;
    font-family: var(--font-header);
    font-size: var(--font-size-small, 14px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sea-salt);
  }

  .proof-strip__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proof-strip__link:focus-visible {
    outline: 2px solid var(--color-harvest-gold);
    outline-offset: 3px;
  }

  .proof-strip__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-small, 14px);
    line-height: var(--line-height-loose, 1.6);
    color: var(--color-sea-salt);
  }

  @media (min-width: 768px) {
    .proof-strip__list {
      grid-template-columns: repeat(min(var(--proof-strip-columns, 2), 2), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .proof-strip__list {
      grid-template-columns: repeat(var(--proof-strip-columns, 4), 1fr);
      gap: var(--spacing-xl, 48px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Proof strip",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "flask", "label": "Flask" },
            { "value": "document", "label": "Document" },
            { "value": "flag", "label": "Flag" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "No synthetic fixatives"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Natural fixatives only: sandalwood, labdanum, benzoin, vetiver."
        },
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this claim",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proof strip",
      "category": "Content",
      "blocks": [
        {
          "type": "claim",
          "settings": {
            "icon": "leaf",
            "heading": "No synthetic fixatives",
            "text": "Natural fixatives only: sandalwood, labdanum, benzoin, vetiver."
          }
        },
        {
          "type": "claim",
          "settings": {
            "icon": "flask",
            "heading": "No parabens or phthalates",
            "text": "Full ingredient list on every product."
          }
        },
        {
          "type": "claim",
          "settings": {
            "icon": "document",
            "heading": "Lab documents",
            "text": "IFRA certificate and GC-MS report, batch by batch.",
            "enabled": false,
            "link": "/pages/lab-reports"
          }
        },
        {
          "type": "claim",
          "settings": {
            "icon": "flag",
            "heading": "Crafted in India",
            "text": "Fragrance for men, made for Indian summers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
