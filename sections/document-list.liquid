<div class="document-list" id="document-list">
  {%- if section.settings.heading != blank -%}
    <div class="document-list__header">
      <h1 class="document-list__page-title">{{ section.settings.heading | escape }}</h1>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="document-list__table-wrapper">
      <table class="document-list__table">
        {%- if section.settings.caption != blank -%}
          <caption class="document-list__caption">{{ section.settings.caption | escape }}</caption>
        {%- endif -%}
        <thead>
          <tr>
            <th scope="col" class="document-list__th" data-col="product">{{ 'sections.document_list.col_product' | t }}</th>
            <th scope="col" class="document-list__th" data-col="batch">{{ 'sections.document_list.col_batch' | t }}</th>
            <th scope="col" class="document-list__th" data-col="type">{{ 'sections.document_list.col_type' | t }}</th>
            <th scope="col" class="document-list__th" data-col="date">{{ 'sections.document_list.col_date' | t }}</th>
            <th scope="col" class="document-list__th" data-col="document">{{ 'sections.document_list.col_document' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'document' -%}
              {%- liquid
                assign link_label = block.settings.label
                if link_label == blank
                  assign link_label = block.settings.document_type
                endif
              -%}
              <tr class="document-list__row" {{ block.shopify_attributes }}>
                <td class="document-list__td" data-label="{{ 'sections.document_list.col_product' | t | escape }}">
                  {{- block.settings.product_name | escape -}}
                </td>
                <td class="document-list__td" data-label="{{ 'sections.document_list.col_batch' | t | escape }}">
                  {{- block.settings.batch | escape -}}
                </td>
                <td class="document-list__td" data-label="{{ 'sections.document_list.col_type' | t | escape }}">
                  {{- block.settings.document_type | escape -}}
                </td>
                <td class="document-list__td" data-label="{{ 'sections.document_list.col_date' | t | escape }}">
                  {{- block.settings.date | escape -}}
                </td>
                <td class="document-list__td" data-label="{{ 'sections.document_list.col_document' | t | escape }}">
                  {%- if block.settings.file != blank -%}
                    <a
                      class="document-list__link"
                      href="{{ block.settings.file }}"
                      target="_blank"
                      rel="noopener"
                    >
                      {{- link_label | escape -}}
                      <span class="visually-hidden"> {{ 'sections.document_list.pdf_suffix' | t }}</span>
                    </a>
                  {%- else -%}
                    <span class="document-list__no-file">{{ 'sections.document_list.not_available' | t }}</span>
                  {%- endif -%}
                </td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- else -%}
    <div class="document-list__empty">
      {{ section.settings.empty_state }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .document-list {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--spacing-xl) var(--page-margin);
  }

  .document-list__header {
    margin-bottom: var(--spacing-xl);
  }

  .document-list__page-title {
    font-family: var(--font-header);
    font-size: var(--font-size-h1);
    color: var(--color-oxford-blue);
    margin: 0;
  }

  .document-list__table-wrapper {
    width: 100%;
    overflow-x: auto;
  }

  .document-list__caption {
    font-family: var(--font-body);
    font-size: var(--font-size-small, 14px);
    color: var(--color-dim-grey);
    text-align: left;
    margin-bottom: var(--spacing-sm);
    caption-side: top;
    padding-bottom: var(--spacing-sm);
  }

  .document-list__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    color: var(--color-oxford-blue);
  }

  .document-list__th {
    font-family: var(--font-header);
    font-size: var(--font-size-caption, 12px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: left;
    padding: var(--spacing-sm) var(--spacing-md) var(--spacing-sm) 0;
    border-bottom: 2px solid var(--color-oxford-blue);
    white-space: nowrap;
  }

  .document-list__th:last-child,
  .document-list__td:last-child {
    padding-right: 0;
  }

  .document-list__td {
    padding: var(--spacing-sm) var(--spacing-md) var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-dim-grey, #ccc);
    vertical-align: top;
    line-height: var(--line-height-relaxed, 1.4);
  }

  .document-list__link {
    color: var(--color-oxford-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .document-list__link:hover {
    opacity: 0.7;
  }

  .document-list__no-file {
    color: var(--color-dim-grey);
    font-size: var(--font-size-small, 14px);
  }

  .document-list__empty {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    color: var(--color-dim-grey);
    padding: var(--spacing-xl) 0;
    border-top: 1px solid var(--color-dim-grey, #ccc);
    border-bottom: 1px solid var(--color-dim-grey, #ccc);
  }

  .document-list__empty p {
    margin: 0;
  }

  /* ── Mobile stacked layout ───────────────────────────────────────────── */
  @media (max-width: 767px) {
    .document-list__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    .document-list__table,
    .document-list__table tbody,
    .document-list__table tr,
    .document-list__table td {
      display: block;
      width: 100%;
    }

    .document-list__row {
      border-bottom: 1px solid var(--color-dim-grey, #ccc);
      padding-bottom: var(--spacing-sm);
      margin-bottom: var(--spacing-sm);
    }

    .document-list__row:last-child {
      border-bottom: none;
      margin-bottom: 0;
    }

    .document-list__td {
      display: grid;
      grid-template-columns: 40% 1fr;
      align-items: baseline;
      gap: var(--spacing-xs, 8px);
      padding: var(--spacing-xs, 6px) 0;
      border-bottom: none;
    }

    .document-list__td::before {
      content: attr(data-label);
      font-family: var(--font-header);
      font-size: var(--font-size-caption, 12px);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-dim-grey);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Document list",
  "tag": "section",
  "blocks": [
    {
      "type": "document",
      "name": "Document",
      "settings": [
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "placeholder": "e.g. Vetiver No.1"
        },
        {
          "type": "text",
          "id": "batch",
          "label": "Batch",
          "placeholder": "e.g. B2401"
        },
        {
          "type": "select",
          "id": "document_type",
          "label": "Document type",
          "options": [
            { "value": "IFRA certificate", "label": "IFRA certificate" },
            { "value": "GC-MS report", "label": "GC-MS report" },
            { "value": "Skin-safety test", "label": "Skin-safety test" },
            { "value": "Other", "label": "Other" }
          ],
          "default": "IFRA certificate"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "placeholder": "e.g. Jan 2025"
        },
        {
          "type": "url",
          "id": "file",
          "label": "File (PDF link or uploaded file URL)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label (optional)",
          "info": "Overrides the document type as the link text. Leave blank to use the document type."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lab reports & certificates"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Table caption",
      "info": "Appears above the table. Useful for a brief description or date of last update."
    },
    {
      "type": "richtext",
      "id": "empty_state",
      "label": "Empty state message",
      "default": "<p>Batch documents will be published here as they are issued.</p>"
    }
  ],
  "presets": [
    {
      "name": "Document list"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
