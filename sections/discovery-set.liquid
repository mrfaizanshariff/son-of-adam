{% comment %}
  SON OF ADAM - Discovery Set Section
  Image plus a three-step explainer and an add-to-bag form for the discovery set product.
  The third step shows the set credit note instead of its free text.
  Renders nothing when no product is selected.
{% endcomment %}

{%- liquid
  assign set_product = section.settings.product
  assign set_variant = set_product.variants.first
-%}

{%- if set_product != blank -%}
  <section class="discovery-set full-width section-spacing" aria-labelledby="discovery-set-heading-{{ section.id }}">
    <div class="discovery-set__container">
      <div class="discovery-set__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 900 }} 900w,
                    {{ section.settings.image | image_url: width: 1200 }} 1200w,
                    {{ section.settings.image | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            class="discovery-set__image"
          >
        {%- else -%}
          <div class="discovery-set__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="discovery-set__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="discovery-set__heading" id="discovery-set-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- else -%}
          <h2 class="visually-hidden" id="discovery-set-heading-{{ section.id }}">{{ set_product.title | escape }}</h2>
        {%- endif -%}

        <p class="discovery-set__price">{{ set_variant.price | money }}</p>

        {%- if section.blocks.size > 0 -%}
          <ol class="discovery-set__steps" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'step' and block.settings.title != blank -%}
                <li class="discovery-set__step" {{ block.shopify_attributes }}>
                  <span class="discovery-set__step-icon">{% render 'claim-icon', icon: block.settings.icon %}</span>
                  <div class="discovery-set__step-body">
                    <h3 class="discovery-set__step-title">{{ block.settings.title | escape }}</h3>
                    {%- if forloop.index == 3 -%}
                      {% render 'set-credit-note',
                        credit_amount: section.settings.credit_amount,
                        days: section.settings.credit_days
                      %}
                    {%- elsif block.settings.text != blank -%}
                      <p class="discovery-set__step-text">{{ block.settings.text | escape }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- form 'product', set_product, class: 'discovery-set__form' -%}
          <input type="hidden" name="id" value="{{ set_variant.id }}">
          {%- if set_variant.available -%}
            <button type="submit" class="btn btn-primary discovery-set__button">{{ 'products.add_to_cart' | t }}</button>
          {%- else -%}
            <button type="submit" class="btn btn-primary discovery-set__button" disabled aria-disabled="true">{{ 'products.sold_out' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .discovery-set {
    inline-size: 100%;
  }

  .discovery-set__container {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    max-inline-size: var(--container-max-width);
    margin-inline: auto;
  }

  .discovery-set__media {
    position: relative;
    inline-size: 100%;
    min-block-size: 300px;
    overflow: hidden;
  }

  .discovery-set__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .discovery-set__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 300px;
    background-color: var(--color-sea-salt);
  }

  .discovery-set__content {
    padding: var(--spacing-xl, 48px) var(--page-margin);
  }

  .discovery-set__heading {
    margin: 0 0 var(--spacing-sm, 16px);
  }

  .discovery-set__price {
    margin: 0 0 var(--spacing-lg, 32px);
    font-family: var(--font-header);
    font-size: 24px;
    font-weight: 600;
    color: var(--color-harvest-gold);
  }

  .discovery-set__steps {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, 24px);
    list-style: none;
    margin: 0 0 var(--spacing-lg, 32px);
    padding: 0;
  }

  .discovery-set__step {
    display: flex;
    gap: var(--spacing-sm, 16px);
    margin: 0;
    padding: 0;
  }

  .discovery-set__step-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-harvest-gold);
  }

  .discovery-set__step-title {
    margin: 0 0 var(--spacing-xs, 8px);
    font-family: var(--font-header);
    font-size: var(--font-size-body, 16px);
    font-weight: 700;
  }

  .discovery-set__step-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-small, 14px);
    line-height: var(--line-height-loose, 1.6);
    color: var(--color-dim-grey);
  }

  .discovery-set__button {
    inline-size: 100%;
  }

  .discovery-set__button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (min-width: 768px) {
    .discovery-set__content {
      padding: var(--spacing-2xl, 64px) var(--spacing-xl, 48px);
    }

    .discovery-set__button {
      inline-size: auto;
      min-inline-size: 240px;
    }
  }

  @media (min-width: 1024px) {
    .discovery-set__container {
      grid-template-columns: 1fr 1fr;
    }

    .discovery-set__media {
      block-size: 100%;
      min-block-size: 500px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Discovery set",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try all six before you choose"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The discovery set product. The first variant is added to the cart."
    },
    {
      "type": "number",
      "id": "credit_amount",
      "label": "Credit amount",
      "default": 500,
      "info": "Credit in rupees, shown in the third step."
    },
    {
      "type": "number",
      "id": "credit_days",
      "label": "Credit validity days",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "flask", "label": "Flask" },
            { "value": "document", "label": "Document" },
            { "value": "flag", "label": "Flag" }
          ],
          "default": "flask"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Order the set"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Not used on the third step, which shows the credit note."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discovery set",
      "category": "Product",
      "settings": {
        "product": "discovery-set"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "flask",
            "title": "Order the set",
            "text": "Six vials, one for each scent."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "leaf",
            "title": "Wear each for a day",
            "text": "Find the one that fits you."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "document",
            "title": "Get credit on a full bottle"
          }
        }
      ]
    }
  ]
}
{% endschema %}
