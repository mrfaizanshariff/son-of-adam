{% comment %}
  SON OF ADAM - Product Detail Page
  50/50 layout with image gallery, buy box, accordions, and related products
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}

<article class="product-page full-width section-spacing" role="main" aria-label="Product details">
  <div class="product-page__container">
    
    {%- comment -%} Breadcrumb Navigation {%- endcomment -%}
    {% render 'breadcrumb' %}
    
    {%- comment -%} Product Main Content: 50/50 Split {%- endcomment -%}
    <div class="product-main">
      
      {%- comment -%} Left: Product Gallery {%- endcomment -%}
      <div class="product-main__gallery">
        {% render 'product-gallery', product: product %}
      </div>
      
      {%- comment -%} Right: Product Info & Buy Box {%- endcomment -%}
      <div class="product-main__info">
        
        {%- comment -%} Product Title {%- endcomment -%}
        <h1 class="product-main__title">{{ product.title }}</h1>
        
        {%- comment -%} Scent Line & Tagline {%- endcomment -%}
        {%- liquid
          assign scent_family = product.metafields.custom.scent_family.value | default: product.metafields.custom.scent_family
          assign concentration = product.metafields.custom.concentration.value | default: product.metafields.custom.concentration
          assign tagline = product.metafields.custom.tagline.value | default: product.metafields.custom.tagline
        -%}
        {% if scent_family != blank or concentration != blank %}
          <p class="product-main__scent-line">
            {% if scent_family != blank and concentration != blank %}
              {{ scent_family }} &middot; {{ concentration }}
            {% elsif scent_family != blank %}
              {{ scent_family }}
            {% else %}
              {{ concentration }}
            {% endif %}
          </p>
        {% endif %}
        {% if tagline != blank %}
          <p class="product-main__tagline">{{ tagline }}</p>
        {% endif %}
        
        {%- comment -%} Star Rating {%- endcomment -%}
        {%- liquid
          assign product_review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0 | plus: 0
          assign product_review_rating = product.metafields.reviews.rating.value | default: product.metafields.reviews.rating | default: 0
        -%}
        {% if section.settings.show_rating and product.metafields.reviews.rating_count != blank and product_review_count > 0 %}
          <div class="product-main__rating">
            {% render 'star-rating', rating: product_review_rating, count: product_review_count %}
          </div>
        {% endif %}
        
        {%- comment -%} Price {%- endcomment -%}
        {%- liquid
          assign product_price_formatted = current_variant.price | money
          assign product_compare_price_formatted = current_variant.compare_at_price | money
        -%}
        <div class="product-main__price" aria-label="{% if current_variant.compare_at_price > current_variant.price %}{{ 'products.price.sale_price' | t: price: product_price_formatted, original: product_compare_price_formatted }}{% else %}{{ 'products.price.regular_price' | t: price: product_price_formatted }}{% endif %}">
          <span class="product-main__price-amount" data-product-price>
            {{ product_price_formatted }}
          </span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s class="product-main__price-compare" data-product-compare-price aria-hidden="true">
              {{ product_compare_price_formatted }}
            </s>
          {% else %}
            <s class="product-main__price-compare" data-product-compare-price aria-hidden="true" style="display: none;"></s>
          {% endif %}
        </div>
        
        {%- comment -%} Product Description {%- endcomment -%}
        {% if product.description != blank %}
          <div class="product-main__description">
            {{ product.description }}
          </div>
        {% endif %}
        
        {%- comment -%} Product Form {%- endcomment -%}
        {% form 'product', product, id: product_form_id, class: 'product-form', data-inventory: current_variant.inventory_quantity, data-available: current_variant.available %}
          
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          
          {%- comment -%} Variant Selector: Radio chips when option has 'Size', select dropdown fallback {%- endcomment -%}
          {% unless product.has_only_default_variant %}
            {%- liquid
              assign size_option = null
              assign size_option_index = 0
              for opt in product.options_with_values
                assign opt_name_down = opt.name | downcase
                if opt_name_down == 'size'
                  assign size_option = opt
                  assign size_option_index = forloop.index0
                  break
                endif
              endfor
            -%}

            {% if size_option != blank %}
              <fieldset class="product-form__fieldset product-form__variants" data-variant-fieldset>
                <legend class="product-form__legend product-form__label">
                  {{ size_option.name }}
                </legend>
                <div class="product-form__radio-group" role="radiogroup" aria-label="{{ size_option.name }}">
                  {% for value in size_option.values %}
                    {% assign variant_for_value = null %}
                    {% for v in product.variants %}
                      {% if v.options[size_option_index] == value %}
                        {% assign variant_for_value = v %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    {% assign is_selected = false %}
                    {% if current_variant.id == variant_for_value.id %}
                      {% assign is_selected = true %}
                    {% endif %}
                    {% assign is_available = variant_for_value.available %}
                    {% assign variant_price_formatted = variant_for_value.price | money_without_trailing_zeros %}
                    
                    <label
                      class="product-form__radio-chip{% if is_selected %} is-selected{% endif %}{% unless is_available %} is-unavailable{% endunless %}"
                      for="variant-radio-{{ variant_for_value.id }}"
                      {% unless is_available %}aria-disabled="true"{% endunless %}
                    >
                      <input
                        type="radio"
                        id="variant-radio-{{ variant_for_value.id }}"
                        name="options[{{ size_option.name }}]"
                        value="{{ value | escape }}"
                        class="product-form__radio-input"
                        data-variant-radio
                        data-variant-id="{{ variant_for_value.id }}"
                        data-price="{{ variant_for_value.price }}"
                        data-compare-price="{{ variant_for_value.compare_at_price | default: 0 }}"
                        data-price-formatted="{{ variant_for_value.price | money }}"
                        data-compare-price-formatted="{{ variant_for_value.compare_at_price | money }}"
                        data-inventory="{{ variant_for_value.inventory_quantity }}"
                        data-available="{{ variant_for_value.available }}"
                        data-inventory-management="{{ variant_for_value.inventory_management }}"
                        {% if is_selected %}checked{% endif %}
                      >
                      <span class="product-form__radio-chip-text{% unless is_available %} is-struck{% endunless %}">
                        {{ value }} &middot; {{ variant_price_formatted }}
                      </span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% else %}
              {% assign fallback_option = product.options_with_values.first %}
              <div class="product-form__variants">
                <label for="variant-selector" class="product-form__label">
                  {{ fallback_option.name }}
                </label>
                <select
                  id="variant-selector"
                  class="product-form__select"
                  aria-label="{{ fallback_option.name }}"
                  data-variant-select
                >
                  {% for variant in product.variants %}
                    <option
                      value="{{ variant.id }}"
                      {% if variant == current_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-inventory="{{ variant.inventory_quantity }}"
                      data-available="{{ variant.available }}"
                      data-price="{{ variant.price }}"
                      data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                      data-price-formatted="{{ variant.price | money }}"
                      data-compare-price-formatted="{{ variant.compare_at_price | money }}"
                    >
                      {{ variant.title }}
                      {% unless variant.available %} - {{ 'products.product.sold_out' | t | default: 'Sold out' }}{% endunless %}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endif %}
          {% endunless %}
          
          {%- comment -%} Gift Options {%- endcomment -%}
          {% if section.settings.show_gift_options %}
            <details class="product-gift-options" data-gift-details>
              <summary class="product-gift-options__summary">
                <span class="product-gift-options__title">{{ 'products.product.gift.title' | t }}</span>
                <svg class="product-gift-options__icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </summary>
              <div class="product-gift-options__content">
                <div class="product-gift-options__field">
                  <label class="product-gift-options__checkbox-label" for="gift-wrap-{{ section.id }}">
                    <input
                      type="checkbox"
                      id="gift-wrap-{{ section.id }}"
                      name="properties[Gift wrap]"
                      value="Yes"
                      class="product-gift-options__checkbox"
                      data-gift-wrap-checkbox
                      disabled
                    >
                    <span>{{ 'products.product.gift.wrap_label' | t }}</span>
                  </label>
                </div>
                <div class="product-gift-options__field">
                  <label for="gift-message-{{ section.id }}" class="product-gift-options__label">
                    {{ 'products.product.gift.message_label' | t }}
                  </label>
                  <textarea
                    id="gift-message-{{ section.id }}"
                    name="properties[Gift message]"
                    maxlength="200"
                    class="product-gift-options__textarea"
                    placeholder="{{ 'products.product.gift.message_placeholder' | t }}"
                    data-gift-message-input
                    disabled
                  ></textarea>
                  <div class="product-gift-options__counter" aria-live="polite">
                    <span data-gift-char-counter>200</span> {{ 'products.product.gift.characters_remaining' | t }}
                  </div>
                </div>
              </div>
            </details>
          {% endif %}

          {%- comment -%} Buy Box Wrapper (hidden when variant is sold out) {%- endcomment -%}
          <div class="product-form__buy-wrapper" data-buy-wrapper {% unless current_variant.available %}style="display: none;"{% endunless %}>
            {%- comment -%} Quantity Selector {%- endcomment -%}
            <div class="product-form__quantity">
              <label for="quantity" class="product-form__label">
                {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity < 7 %}
                  <span class="product-form__stock product-form__stock--low">{{ 'products.product.only_n_left' | t: count: current_variant.inventory_quantity }}</span>
                {% endif %}
              </label>
              {% assign max_quantity = current_variant.inventory_quantity | default: 999 %}
              {% render 'quantity-selector', id: 'quantity', value: 1, min: 1, max: max_quantity %}
            </div>
            
            {%- comment -%} Add to Cart Button {%- endcomment -%}
            <button
              type="submit"
              name="add"
              class="product-form__submit btn btn-primary"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {% if current_variant.available %}
                {{ 'products.product.add_to_cart' | t | upcase }}
              {% else %}
                {{ 'products.product.sold_out' | t | upcase }}
              {% endif %}
            </button>

            <p class="product__message" role="status" aria-live="polite" data-message-template="{{ 'products.product.max_quantity' | t: cart_quantity: '[cart_quantity]', available: '[available]' }}"></p>
            
            {%- comment -%} Dynamic Checkout Buttons {%- endcomment -%}
            {% if section.settings.show_dynamic_checkout %}
              {{ form | payment_button }}
            {% endif %}
          </div>
          
        {% endform %}

        {%- comment -%} Sold-out Restock Notification Form {%- endcomment -%}
        <div class="product-restock-wrapper" data-restock-wrapper {% if current_variant.available %}style="display: none;"{% endif %}>
          {% form 'customer', id: 'restock-form', class: 'product-restock-form' %}
            <input type="hidden" name="contact[tags]" value="restock-{{ product.handle }}">
            
            {% if form.posted_successfully? %}
              <div class="product-restock__success" role="status" aria-live="polite">
                {{ 'products.product.restock.success' | t }}
              </div>
            {% else %}
              <div class="product-restock__content">
                <label for="restock-email-{{ section.id }}" class="product-restock__label product-form__label">
                  {{ 'products.product.restock.label' | t }}
                </label>
                <p class="product-restock__description">
                  {{ 'products.product.restock.description' | t }}
                </p>
                <div class="product-restock__input-row">
                  <input
                    type="email"
                    id="restock-email-{{ section.id }}"
                    name="contact[email]"
                    class="product-restock__input"
                    placeholder="{{ 'products.product.restock.placeholder' | t }}"
                    required
                    aria-required="true"
                  >
                  <button type="submit" class="btn btn-primary product-restock__button">
                    {{ 'products.product.restock.button' | t }}
                  </button>
                </div>
              </div>
            {% endif %}
          {% endform %}
        </div>

        {%- comment -%} Try First Discovery Set Row {%- endcomment -%}
        {% assign set_credit_val = section.settings.set_credit | default: 0 %}
        {% if set_credit_val > 0 and product.handle != 'discovery-set' %}
          <div class="product-try-first">
            <div class="product-try-first__header">
              <a href="/products/discovery-set" class="product-try-first__link">
                {{ 'products.product.try_first' | t }} &rarr;
              </a>
            </div>
            {% render 'set-credit-note',
              credit_amount: section.settings.set_credit,
              days: section.settings.set_credit_days,
              style: 'box'
            %}
          </div>
        {% endif %}

        {%- comment -%} Trust Lines {%- endcomment -%}
        <div class="product-trust-lines">
          {% for block in section.blocks %}
            {% if block.type == 'trust_line' and block.settings.text != blank %}
              <div class="product-trust-line" {{ block.shopify_attributes }}>
                <span class="product-trust-line__icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'truck' %}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                      </svg>
                    {% when 'return' %}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                      </svg>
                    {% else %}
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                      </svg>
                  {% endcase %}
                </span>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="product-trust-line__text product-trust-line__link">
                    {{ block.settings.text }}
                  </a>
                {% else %}
                  <span class="product-trust-line__text">
                    {{ block.settings.text }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        
        {%- comment -%} Product Details Accordions - Below Buy Button {%- endcomment -%}
        <div class="product-info__accordions">
          {%- assign ingredients = product.metafields.custom.ingredients_inci.value | default: product.metafields.custom.ingredients_inci -%}
          {% if ingredients != blank %}
            {% render 'product-accordion',
              title: 'Ingredients',
              content: ingredients,
              open: false
            %}
          {% endif %}
          
          {% if section.settings.how_to_wear != blank %}
            {% render 'product-accordion',
              title: 'How to wear',
              content: section.settings.how_to_wear,
              open: false
            %}
          {% endif %}
          
          {% if section.settings.shipping_returns != blank %}
            {% render 'product-accordion',
              title: 'Shipping and returns',
              content: section.settings.shipping_returns,
              open: false
            %}
          {% endif %}

          {% capture questions_content %}
            <p>{{ 'products.product.faq_note' | t }} <a href="/pages/faq" class="product-accordion__faq-link">{{ 'products.product.faq_link_text' | t }} &rarr;</a></p>
          {% endcapture %}
          {% render 'product-accordion',
            title: 'Questions',
            content: questions_content,
            open: false
          %}
          
          {%- comment -%} Custom Dynamic Accordions {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'accordion' and block.settings.content != blank %}
              {% render 'product-accordion',
                title: block.settings.title,
                content: block.settings.content,
                open: false
              %}
            {% elsif block.type == '@app' %}
              {% render block %}
            {% endif %}
          {% endfor %}
        </div>
        
      </div>
    </div>
    
  </div>
</article>

{%- comment -%}
  Product Proof section is rendered via template (Prompt 4)
  {% render 'product-proof', product: product %}
{%- endcomment -%}

{%- comment -%} Brand Philosophy Section {%- endcomment -%}
{% if section.settings.show_brand_section %}
  <div class="product-brand-section full-width">
    <div class="product-brand-section__container">
      <div class="product-brand-section__content">
        <p class="product-brand-section__label">{{ section.settings.ritual_heading | default: 'products.product.the_ritual' | t }}</p>
        <h2 class="product-brand-section__title">
          {{ section.settings.brand_title | default: 'CRAFTED FOR THE DISCERNING FEW.' }}
        </h2>
        <p class="product-brand-section__description">
          {% if section.settings.brand_description != blank %}
            {{ section.settings.brand_description }}
          {% else %}
            Every drop is a testament to the pursuit of excellence. We don't just create products; we create experiences for the Son of Adam who demands more from his routine.
          {% endif %}
        </p>
        {% if section.settings.brand_button_text != blank and section.settings.brand_button_url != blank %}
          <a href="{{ section.settings.brand_button_url }}" class="btn btn-secondary">
            {{ section.settings.brand_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{%- comment -%} Related Products Section {%- endcomment -%}
{% if section.settings.show_related_products %}
  <div class="product-related full-width section-spacing">
    <div class="product-related__container">
      <h2 class="product-related__title">{{ section.settings.related_heading | default: 'products.product.you_may_also_like' | t }}</h2>
      
      <div class="product-related__grid">
        {% if section.settings.related_products_collection != blank %}
          {% assign related_collection = collections[section.settings.related_products_collection] %}
          {% for related_product in related_collection.products limit: 4 %}
            {% unless related_product.id == product.id %}
              {% render 'product-card', product: related_product %}
            {% endunless %}
          {% endfor %}
        {% else %}
          {%- comment -%} Show products from same collection {%- endcomment -%}
          {% if product.collections.size > 0 %}
            {% assign first_collection = product.collections.first %}
            {% for related_product in first_collection.products limit: 4 %}
              {% unless related_product.id == product.id %}
                {% render 'product-card', product: related_product %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{%- comment -%} Product Reviews Section {%- endcomment -%}
{% if section.settings.show_reviews %}
  {% render 'product-reviews', product: product, show_form: section.settings.show_review_form, allow_review_submission: section.settings.allow_review_submission %}
{% endif %}

<script>
  // Product Form Functionality with Cart Inventory Validation & Size Radio Chips
  (function() {
    const variantSelect = document.querySelector('[data-variant-select]');
    const variantRadios = document.querySelectorAll('[data-variant-radio]');
    const variantIdInput = document.querySelector('[data-variant-id]');
    const quantityInput = document.querySelector('[data-quantity-input]');
    const submitButton = document.querySelector('.product-form__submit');
    const productForm = document.querySelector('.product-form');
    const buyWrapper = document.querySelector('[data-buy-wrapper]');
    const restockWrapper = document.querySelector('[data-restock-wrapper]');
    const priceAmountEl = document.querySelector('[data-product-price]');
    const priceCompareEl = document.querySelector('[data-product-compare-price]');
    
    let cartState = null;
    let currentVariantId = variantIdInput ? variantIdInput.value : null;
    
    // Fetch current cart state
    async function fetchCart() {
      try {
        const response = await fetch('/cart.js');
        if (!response.ok) throw new Error('Failed to fetch cart');
        cartState = await response.json();
        return cartState;
      } catch (error) {
        console.error('Error fetching cart:', error);
        return null;
      }
    }
    
    // Get quantity of current variant in cart
    function getCartQuantityForVariant(variantId) {
      if (!cartState || !cartState.items) return 0;
      
      const cartItem = cartState.items.find(item => item.variant_id == variantId);
      return cartItem ? cartItem.quantity : 0;
    }
    
    // Calculate available quantity (inventory - cart quantity)
    function getAvailableQuantity(inventory, variantId) {
      const cartQuantity = getCartQuantityForVariant(variantId);
      return Math.max(0, inventory - cartQuantity);
    }
    
    // Update UI based on available quantity & restock state
    function updateAvailabilityUI(variantId, inventory, available) {
      const cartQuantity = getCartQuantityForVariant(variantId);
      const availableToAdd = getAvailableQuantity(inventory, variantId);
      
      // Toggle restock form vs buy wrapper
      if (!available) {
        if (buyWrapper) buyWrapper.style.display = 'none';
        if (restockWrapper) restockWrapper.style.display = 'block';
        return;
      } else {
        if (buyWrapper) buyWrapper.style.display = 'block';
        if (restockWrapper) restockWrapper.style.display = 'none';
      }

      // Create or update availability message
      let availabilityMsg = document.querySelector('.product-availability-message');
      if (!availabilityMsg && submitButton) {
        availabilityMsg = document.createElement('p');
        availabilityMsg.className = 'product-availability-message';
        submitButton.parentNode.insertBefore(availabilityMsg, submitButton);
      }
      
      // Update quantity input max
      if (quantityInput) {
        quantityInput.setAttribute('max', availableToAdd);
        if (parseInt(quantityInput.value) > availableToAdd) {
          quantityInput.value = Math.max(1, availableToAdd);
        }
      }
      
      // Update button and message based on availability
      if (!available || inventory === 0) {
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'SOLD OUT';
        }
        if (availabilityMsg) {
          availabilityMsg.textContent = '';
          availabilityMsg.style.display = 'none';
        }
      } else if (cartQuantity >= inventory) {
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'MAXIMUM IN CART';
        }
        if (availabilityMsg) {
          availabilityMsg.textContent = `You already have ${cartQuantity} in your cart (maximum available)`;
          availabilityMsg.style.display = 'block';
          availabilityMsg.className = 'product-availability-message product-availability-message--warning';
        }
      } else if (availableToAdd <= 5 && availableToAdd > 0) {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'ADD TO CART';
        }
        if (availabilityMsg) {
          if (cartQuantity > 0) {
            availabilityMsg.textContent = `${cartQuantity} in cart, only ${availableToAdd} more available`;
          } else {
            availabilityMsg.textContent = `Only ${availableToAdd} available`;
          }
          availabilityMsg.style.display = 'block';
          availabilityMsg.className = 'product-availability-message product-availability-message--low';
        }
      } else {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'ADD TO CART';
        }
        if (availabilityMsg) {
          if (cartQuantity > 0) {
            availabilityMsg.textContent = `${cartQuantity} already in cart`;
            availabilityMsg.style.display = 'block';
            availabilityMsg.className = 'product-availability-message product-availability-message--info';
          } else {
            availabilityMsg.textContent = '';
            availabilityMsg.style.display = 'none';
          }
        }
      }
    }
    
    // Validate before form submission
    async function validateBeforeSubmit(e) {
      e.preventDefault();
      
      if (!variantIdInput || !quantityInput || !productForm) {
        console.error('Required form elements not found');
        return false;
      }
      
      const variantId = variantIdInput.value;
      const requestedQuantity = parseInt(quantityInput.value) || 1;
      
      // Fetch latest cart state
      await fetchCart();
      
      // Get inventory from variant select or radio data attribute
      let inventory = 999;
      if (variantRadios && variantRadios.length > 0) {
        const checkedRadio = document.querySelector('[data-variant-radio]:checked');
        if (checkedRadio && checkedRadio.dataset.inventory) {
          inventory = parseInt(checkedRadio.dataset.inventory);
        }
      } else if (variantSelect) {
        const selectedOption = variantSelect.querySelector(`option[value="${variantId}"]`);
        if (selectedOption && selectedOption.dataset.inventory) {
          inventory = parseInt(selectedOption.dataset.inventory);
        }
      } else {
        const formInventory = productForm.dataset.inventory;
        if (formInventory) {
          inventory = parseInt(formInventory);
        }
      }
      
      const cartQuantity = getCartQuantityForVariant(variantId);
      const totalQuantity = cartQuantity + requestedQuantity;
      
      // Validate total quantity against inventory
      if (totalQuantity > inventory) {
        const availableToAdd = Math.max(0, inventory - cartQuantity);
        const messageEl = productForm.querySelector('.product__message') || document.querySelector('.product__message');
        if (messageEl) {
          const template = messageEl.dataset.messageTemplate || 'Cannot add that amount. Maximum available quantity reached.';
          messageEl.textContent = template
            .replace('[cart_quantity]', cartQuantity)
            .replace('[available]', availableToAdd);
        }
        if (quantityInput) {
          quantityInput.value = availableToAdd;
        }
        return false;
      }
      
      // If validation passes, submit the form
      productForm.submit();
    }
    
    // Quantity Controls
    if (quantityInput) {
      quantityInput.addEventListener('quantity:limit', (event) => {
        if (event.detail.type !== 'max') return;
        const max = parseInt(quantityInput.getAttribute('max')) || 999;
        const availabilityMsg = document.querySelector('.product-availability-message');
        if (availabilityMsg) {
          availabilityMsg.textContent = 'Maximum available quantity reached';
          availabilityMsg.className = 'product-availability-message product-availability-message--warning';
          setTimeout(() => {
            updateAvailabilityUI(currentVariantId, max + getCartQuantityForVariant(currentVariantId), true);
          }, 2000);
        }
      });
    }

    // Helper: update price display
    function updatePriceDisplay(priceFormatted, comparePriceFormatted, hasCompare) {
      if (priceAmountEl && priceFormatted) {
        priceAmountEl.textContent = priceFormatted;
      }
      if (priceCompareEl) {
        if (hasCompare && comparePriceFormatted) {
          priceCompareEl.textContent = comparePriceFormatted;
          priceCompareEl.style.display = '';
        } else {
          priceCompareEl.style.display = 'none';
        }
      }
    }
    
    // Variant Selection via Radio Chips
    if (variantRadios && variantRadios.length > 0) {
      variantRadios.forEach(radio => {
        radio.addEventListener('change', async function() {
          const variantId = this.dataset.variantId;
          const inventory = parseInt(this.dataset.inventory) || 999;
          const available = this.dataset.available === 'true';
          const priceFormatted = this.dataset.priceFormatted;
          const comparePriceFormatted = this.dataset.comparePriceFormatted;
          const price = parseInt(this.dataset.price) || 0;
          const comparePrice = parseInt(this.dataset.comparePrice) || 0;
          
          currentVariantId = variantId;
          
          // Clear message
          const messageEl = document.querySelector('.product__message');
          if (messageEl) {
            messageEl.textContent = '';
          }

          // Update hidden input
          if (variantIdInput) {
            variantIdInput.value = variantId;
          }

          // Update chip selected classes
          document.querySelectorAll('.product-form__radio-chip').forEach(chip => {
            chip.classList.remove('is-selected');
          });
          const parentLabel = this.closest('.product-form__radio-chip');
          if (parentLabel) {
            parentLabel.classList.add('is-selected');
          }

          // Update price display
          updatePriceDisplay(priceFormatted, comparePriceFormatted, comparePrice > price);
          
          // Fetch cart and update UI
          await fetchCart();
          updateAvailabilityUI(variantId, inventory, available);
          
          // Update URL
          const url = new URL(window.location.href);
          url.searchParams.set('variant', variantId);
          window.history.replaceState({}, '', url);
        });
      });
    }

    // Variant Selection via Select Dropdown (Fallback)
    if (variantSelect && variantIdInput) {
      variantSelect.addEventListener('change', async function() {
        const selectedOption = this.options[this.selectedIndex];
        const variantId = selectedOption.value;
        const inventory = parseInt(selectedOption.dataset.inventory) || 999;
        const available = selectedOption.dataset.available === 'true';
        const priceFormatted = selectedOption.dataset.priceFormatted;
        const comparePriceFormatted = selectedOption.dataset.comparePriceFormatted;
        const price = parseInt(selectedOption.dataset.price) || 0;
        const comparePrice = parseInt(selectedOption.dataset.comparePrice) || 0;
        
        currentVariantId = variantId;
        
        // Clear message
        const messageEl = document.querySelector('.product__message');
        if (messageEl) {
          messageEl.textContent = '';
        }

        // Update hidden input
        variantIdInput.value = variantId;

        // Update price display
        updatePriceDisplay(priceFormatted, comparePriceFormatted, comparePrice > price);
        
        // Fetch cart and update UI
        await fetchCart();
        updateAvailabilityUI(variantId, inventory, available);
        
        // Update URL
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        window.history.replaceState({}, '', url);
      });
    }

    // Gift Options functionality
    const giftDetails = document.querySelector('[data-gift-details]');
    const giftWrapCheckbox = document.querySelector('[data-gift-wrap-checkbox]');
    const giftMessageInput = document.querySelector('[data-gift-message-input]');
    const giftCharCounter = document.querySelector('[data-gift-char-counter]');

    if (giftWrapCheckbox) {
      giftWrapCheckbox.addEventListener('change', function() {
        if (this.checked) {
          this.removeAttribute('disabled');
        } else {
          this.setAttribute('disabled', '');
        }
      });
    }

    if (giftMessageInput && giftCharCounter) {
      giftMessageInput.addEventListener('input', function() {
        const remaining = 200 - this.value.length;
        giftCharCounter.textContent = Math.max(0, remaining);
        if (this.value.trim().length > 0) {
          this.removeAttribute('disabled');
        } else {
          this.setAttribute('disabled', '');
        }
      });
      // Enable input interaction on focus
      giftMessageInput.addEventListener('focus', function() {
        this.removeAttribute('disabled');
      });
      giftMessageInput.addEventListener('blur', function() {
        if (this.value.trim().length === 0) {
          this.setAttribute('disabled', '');
        }
      });
    }
    
    // Form submission validation
    if (productForm && submitButton) {
      productForm.addEventListener('submit', validateBeforeSubmit);
    }
    
    // Initialize: Fetch cart and update UI on page load
    (async function init() {
      await fetchCart();
      
      if (variantRadios && variantRadios.length > 0) {
        const checkedRadio = document.querySelector('[data-variant-radio]:checked') || variantRadios[0];
        if (checkedRadio) {
          const inventory = parseInt(checkedRadio.dataset.inventory) || 999;
          const available = checkedRadio.dataset.available === 'true';
          updateAvailabilityUI(currentVariantId, inventory, available);
        }
      } else if (variantSelect) {
        const selectedOption = variantSelect.options[variantSelect.selectedIndex];
        const inventory = parseInt(selectedOption.dataset.inventory) || 999;
        const available = selectedOption.dataset.available === 'true';
        updateAvailabilityUI(currentVariantId, inventory, available);
      } else if (productForm && currentVariantId) {
        const inventory = parseInt(productForm.dataset.inventory) || 999;
        const available = productForm.dataset.available === 'true';
        updateAvailabilityUI(currentVariantId, inventory, available);
      }
    })();
    
    // Listen for cart updates from other pages
    window.addEventListener('storage', function(e) {
      if (e.key === 'cart_updated') {
        fetchCart().then(() => {
          if (variantRadios && variantRadios.length > 0) {
            const checkedRadio = document.querySelector('[data-variant-radio]:checked');
            if (checkedRadio) {
              const inventory = parseInt(checkedRadio.dataset.inventory) || 999;
              const available = checkedRadio.dataset.available === 'true';
              updateAvailabilityUI(currentVariantId, inventory, available);
            }
          } else if (variantSelect) {
            const selectedOption = variantSelect.options[variantSelect.selectedIndex];
            const inventory = parseInt(selectedOption.dataset.inventory) || 999;
            const available = selectedOption.dataset.available === 'true';
            updateAvailabilityUI(currentVariantId, inventory, available);
          } else if (productForm && currentVariantId) {
            const inventory = parseInt(productForm.dataset.inventory) || 999;
            const available = productForm.dataset.available === 'true';
            updateAvailabilityUI(currentVariantId, inventory, available);
          }
        });
      }
    });
  })();
</script>

