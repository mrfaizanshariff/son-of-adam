{% comment %}
  SON OF ADAM - Product detail shell
  50/50 layout: image gallery on the left, a stack of reorderable theme blocks on the right.
  Brand, related products and reviews are separate sections (product-brand, product-related, product-reviews).
{% endcomment %}

<article class="product-page full-width section-spacing" aria-label="{{ 'products.product.details_label' | t }}" data-product-root>
  <div class="product-page__container">
    {% render 'breadcrumb' %}

    <div class="product-main">
      <div class="product-main__gallery">
        {% render 'product-gallery', product: product %}
      </div>

      <div class="product-main__info">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</article>

{% stylesheet %}
  .product-page {
    background-color: var(--color-background);
  }

  .product-page__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .product-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4xl);
    margin-bottom: var(--spacing-4xl);
  }

  .product-main__gallery {
    position: sticky;
    top: var(--spacing-md);
    align-self: start;
  }

  @media (max-width: 1023px) {
    .product-main {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }

    .product-main__gallery {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "blocks": [
    { "type": "@app" },
    { "type": "_product-title" },
    { "type": "_product-scent-line" },
    { "type": "_product-tagline" },
    { "type": "_product-rating" },
    { "type": "_product-price" },
    { "type": "_product-description" },
    { "type": "_product-buy-box" },
    { "type": "_product-restock" },
    { "type": "_product-try-first" },
    { "type": "_product-trust-lines" },
    { "type": "_product-accordion" },
    { "type": "_product-ingredients" },
    { "type": "_product-questions" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product",
      "blocks": {
        "title": { "type": "_product-title" },
        "scent_line": { "type": "_product-scent-line" },
        "tagline": { "type": "_product-tagline" },
        "rating": { "type": "_product-rating" },
        "price": { "type": "_product-price" },
        "description": { "type": "_product-description" },
        "buy_box": {
          "type": "_product-buy-box",
          "blocks": {
            "variant_picker": { "type": "_product-variant-picker" },
            "gift_options": { "type": "_product-gift-options" },
            "quantity_add_to_cart": { "type": "_product-quantity-add-to-cart" }
          },
          "block_order": ["variant_picker", "gift_options", "quantity_add_to_cart"]
        },
        "restock": { "type": "_product-restock" },
        "try_first": { "type": "_product-try-first" },
        "trust_lines": { "type": "_product-trust-lines" },
        "ingredients": { "type": "_product-ingredients" },
        "how_to_wear": { "type": "_product-accordion", "settings": { "title": "How to wear" } },
        "shipping_returns": { "type": "_product-accordion", "settings": { "title": "Shipping and returns" } },
        "questions": { "type": "_product-questions" }
      },
      "block_order": [
        "title",
        "scent_line",
        "tagline",
        "rating",
        "price",
        "description",
        "buy_box",
        "restock",
        "try_first",
        "trust_lines",
        "ingredients",
        "how_to_wear",
        "shipping_returns",
        "questions"
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
