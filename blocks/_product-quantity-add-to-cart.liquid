{% doc %}
  Renders the quantity selector, add to cart button and status message.
  Hidden by the Buy box block when the selected variant is sold out.
  Must be nested inside the Buy box block.
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign max_quantity = current_variant.inventory_quantity | default: 999
  assign quantity_id = 'quantity-' | append: block.id
-%}

<div class="product-form__buy-wrapper" data-buy-wrapper {% unless current_variant.available %}style="display: none;"{% endunless %} {{ block.shopify_attributes }}>
  <div class="product-form__quantity">
    <label for="{{ quantity_id }}" class="product-form__label">
      {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity < 7 %}
        <span class="product-form__stock product-form__stock--low">{{ 'products.product.only_n_left' | t: count: current_variant.inventory_quantity }}</span>
      {% endif %}
    </label>
    {% render 'quantity-selector', id: quantity_id, value: 1, min: 1, max: max_quantity %}
  </div>

  <button
    type="submit"
    name="add"
    class="product-form__submit btn btn-primary"
    {% unless current_variant.available %}disabled{% endunless %}
  >
    {% if current_variant.available %}
      {{ 'products.product.add_to_cart' | t | upcase }}
    {% else %}
      {{ 'products.product.sold_out' | t | upcase }}
    {% endif %}
  </button>

  <p class="product__message" role="status" aria-live="polite" data-message-template="{{ 'products.product.max_quantity' | t: cart_quantity: '[cart_quantity]', available: '[available]' }}"></p>
</div>

{% stylesheet %}
  .product-form__stock {
    font-size: 13px;
    font-weight: 500;
  }

  .product-form__stock--low {
    color: #991B1B;
  }

  .product-form__submit {
    width: 100%;
    padding: 16px 32px;
    margin-top: var(--spacing-sm);
  }

  .product-form__submit:disabled {
    background-color: var(--color-dim-grey);
    cursor: not-allowed;
    opacity: 0.6;
  }

  .product__message {
    font-family: var(--font-body);
    font-size: 14px;
    color: #991B1B;
    margin-top: var(--spacing-xs);
    margin-bottom: 0;
  }

  .product__message:empty {
    display: none;
  }

  .product-availability-message {
    font-family: var(--font-body);
    font-size: 14px;
    padding: 12px 16px;
    margin-bottom: var(--spacing-sm);
    border-radius: 4px;
    text-align: center;
  }

  .product-availability-message--info {
    background-color: #E0F2FE;
    color: #075985;
    border: 1px solid #BAE6FD;
  }

  .product-availability-message--low {
    background-color: #FEF3C7;
    color: #92400E;
    border: 1px solid #FDE68A;
  }

  .product-availability-message--warning {
    background-color: #FEE2E2;
    color: #991B1B;
    border: 1px solid #FECACA;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quantity and add to cart",
  "settings": []
}
{% endschema %}
