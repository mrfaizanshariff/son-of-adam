{% doc %}
  Renders one trust line with an icon and optional link.
  Intended to be nested inside the Trust lines block.
{% enddoc %}

{% if block.settings.text != blank %}
  <div class="product-trust-line" {{ block.shopify_attributes }}>
    <span class="product-trust-line__icon" aria-hidden="true">
      {% case block.settings.icon %}
        {% when 'truck' %}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        {% when 'return' %}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
        {% else %}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
      {% endcase %}
    </span>
    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}" class="product-trust-line__text product-trust-line__link">
        {{ block.settings.text }}
      </a>
    {% else %}
      <span class="product-trust-line__text">
        {{ block.settings.text }}
      </span>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .product-trust-line {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-oxford-blue);
  }

  .product-trust-line__icon {
    color: var(--color-harvest-gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .product-trust-line__link {
    color: var(--color-oxford-blue);
    text-decoration: underline;
  }

  .product-trust-line__link:hover {
    color: var(--color-harvest-gold);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust line",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "shield", "label": "Shield (Security)" },
        { "value": "truck", "label": "Truck (Shipping)" },
        { "value": "return", "label": "Return (Returns)" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Secure payment"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    }
  ]
}
{% endschema %}
