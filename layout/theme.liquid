<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}

    {%- comment -%} Performance: Resource Hints {%- endcomment -%}
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% render 'css-variables' %}

    {% comment %}
      Custom Font Preloading:
      Preload only the font files needed for text that's guaranteed
      above the fold on every page - the header nav (rendered via
      {% sections 'header-group' %} before content_for_layout) and the
      default body weight. Section headings vary by template/position
      and aren't preloaded to avoid competing with these for bandwidth.
      - Old London (Display, 400): Hero headlines
      - Flama Condensed (Header, 500): Nav links (.header__menu-link) - the
        actual weight rendered in the header, present on every page
      - Flama Condensed (Header, 700): Most common weight for section
        headings elsewhere in the theme
      - Mosvita (Body, 400): Default body text weight
    {% endcomment %}

    {{ 'OldLondonAlternate.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'FlamaCondensedTrial-Medium.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'FlamaCondensedTrial-Bold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'Mosvita-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>

  <body>
    <a href="#main-content" class="skip-to-content sr-only">{{ 'accessibility.skip_to_content' | t | default: 'Skip to main content' }}</a>
    {% sections 'header-group' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
