{% doc %}
  Reusable Button Component for SON OF ADAM Theme

  @param {string} text - Button text (required)
  @param {string} [url] - Optional destination URL
  @param {string} [style] - 'primary' or 'secondary' (default: 'primary')
  @param {string} [size] - 'small', 'medium', 'large' (default: 'medium')
  @param {boolean} [full_width] - Full width toggle (default: false)
  @param {boolean} [dark_bg] - For secondary buttons on dark backgrounds (default: false)
  @param {string} [class] - Additional CSS classes
  @param {string} [target] - Anchor target attribute
  @param {string} [rel] - Anchor rel attribute

  @example
  {% render 'button', text: 'Shop Now', url: '/collections/all', style: 'primary' %}
{% enddoc %}

{% liquid
  assign button_style = style | default: 'primary'
  assign button_size = size | default: 'medium'
  assign button_full = full_width | default: false
  assign button_dark = dark_bg | default: false
  assign button_text = text
  assign button_url = url
  assign button_class = class | default: ''
  assign button_target = target | default: ''
  assign button_rel = rel | default: ''

  # Build CSS classes
  assign css_classes = 'btn'
  
  if button_style == 'primary'
    assign css_classes = css_classes | append: ' btn-primary'
  elsif button_style == 'secondary'
    assign css_classes = css_classes | append: ' btn-secondary'
    if button_dark
      assign css_classes = css_classes | append: ' btn-secondary--dark'
    endif
  endif
  
  if button_size == 'small'
    assign css_classes = css_classes | append: ' btn--small'
  elsif button_size == 'large'
    assign css_classes = css_classes | append: ' btn--large'
  endif
  
  if button_full
    assign css_classes = css_classes | append: ' btn--full'
  endif
  
  if button_class != blank
    assign css_classes = css_classes | append: ' ' | append: button_class
  endif
%}

{% if button_url != blank %}
  <a
    href="{{ button_url }}"
    class="{{ css_classes }}"
    {%- if button_target != blank %} target="{{ button_target | escape }}"{% endif %}
    {%- if button_rel != blank %} rel="{{ button_rel | escape }}"{% endif %}
  >
    {{ button_text | escape }}
  </a>
{% else %}
  <button type="button" class="{{ css_classes }}">
    {{ button_text | escape }}
  </button>
{% endif %}