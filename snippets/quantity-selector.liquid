{% doc %}
  Quantity Selector Snippet
  Displays +/- buttons with accessible quantity input

  @param {string} [id] - Element ID for the input (default: 'quantity')
  @param {number} [value] - Starting quantity value (default: 1)
  @param {number} [min] - Minimum allowed quantity (default: 1)
  @param {number} [max] - Maximum allowed quantity
  @param {string} [line_key] - Optional cart line item key

  @example
  {% render 'quantity-selector', id: 'quantity', value: 1, min: 1, max: 10 %}
{% enddoc %}

{%- liquid
  assign qty_id = id | default: 'quantity'
  assign qty_value = value | default: 1
  assign qty_min = min | default: 1
-%}

<div class="quantity-selector">
  <button
    type="button"
    class="quantity-selector__button quantity-selector__button--minus"
    aria-label="{{ 'accessibility.decrease_quantity' | t | default: 'Decrease quantity' }}"
    data-quantity-minus
  >
    <svg width="12" height="2" viewBox="0 0 12 2" fill="none">
      <path d="M0 1H12" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>

  <input
    type="number"
    id="{{ qty_id }}"
    name="quantity"
    value="{{ qty_value }}"
    min="{{ qty_min }}"
    {%- if max %} max="{{ max }}"{% endif %}
    {%- if line_key %} data-line-key="{{ line_key }}"{% endif %}
    class="quantity-selector__input"
    aria-label="{{ 'accessibility.quantity' | t | default: 'Quantity' }}"
    data-quantity-input
  >

  <button
    type="button"
    class="quantity-selector__button quantity-selector__button--plus"
    aria-label="{{ 'accessibility.increase_quantity' | t | default: 'Increase quantity' }}"
    data-quantity-plus
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
      <path d="M6 0V12M0 6H12" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>
</div>

{% stylesheet %}
  .quantity-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-dim-grey);
    background-color: var(--color-white);
  }

  .quantity-selector__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    color: var(--color-oxford-blue);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .quantity-selector__button:hover {
    background-color: var(--color-sea-salt);
  }

  .quantity-selector__button:active {
    background-color: #E5E5E5;
  }

  .quantity-selector__input {
    width: 60px;
    height: 40px;
    border: none;
    border-left: 1px solid var(--color-dim-grey);
    border-right: 1px solid var(--color-dim-grey);
    text-align: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-oxford-blue);
    background-color: var(--color-white);
    -moz-appearance: textfield;
  }

  .quantity-selector__input::-webkit-outer-spin-button,
  .quantity-selector__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .quantity-selector__input:focus {
    outline: 2px solid var(--color-harvest-gold);
    outline-offset: -2px;
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    function getMin(input) {
      var min = parseInt(input.getAttribute('min'), 10);
      return isNaN(min) ? 0 : min;
    }

    function getMax(input) {
      if (!input.hasAttribute('max')) return Infinity;
      var max = parseInt(input.getAttribute('max'), 10);
      return isNaN(max) ? Infinity : max;
    }

    function setQuantity(input, value) {
      input.value = value;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Delegated on document so this works for any number of
    // quantity-selector instances rendered on the page, including
    // ones added after this script first ran.
    document.addEventListener('click', function(event) {
      var button = event.target.closest('[data-quantity-minus], [data-quantity-plus]');
      if (!button) return;

      var wrapper = button.closest('.quantity-selector');
      var input = wrapper && wrapper.querySelector('[data-quantity-input]');
      if (!input) return;

      var min = getMin(input);
      var max = getMax(input);
      var current = parseInt(input.value, 10);
      if (isNaN(current)) current = min;

      if (button.hasAttribute('data-quantity-minus')) {
        if (current > min) {
          setQuantity(input, current - 1);
        } else {
          input.dispatchEvent(new CustomEvent('quantity:limit', { bubbles: true, detail: { type: 'min' } }));
        }
      } else {
        if (current < max) {
          setQuantity(input, current + 1);
        } else {
          input.dispatchEvent(new CustomEvent('quantity:limit', { bubbles: true, detail: { type: 'max' } }));
        }
      }
    });

    document.addEventListener('input', function(event) {
      var input = event.target.closest('[data-quantity-input]');
      if (!input) return;
      var max = getMax(input);
      if (max !== Infinity && input.value !== '' && parseInt(input.value, 10) > max) {
        input.value = max;
      }
    });

    document.addEventListener('change', function(event) {
      var input = event.target.closest('[data-quantity-input]');
      if (!input) return;
      var min = getMin(input);
      var max = getMax(input);
      var value = parseInt(input.value, 10);
      if (isNaN(value) || value < min) {
        input.value = min;
      } else if (max !== Infinity && value > max) {
        input.value = max;
      }
    });
  })();
{% endjavascript %}
